{
  "name": "afrikcompute",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @afrikcompute/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter @afrikcompute/api --filter @afrikcompute/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm --filter @afrikcompute/api auth:selftest && pnpm --filter @afrikcompute/api session4:selftest && pnpm --filter @afrikcompute/api privacy:check"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
